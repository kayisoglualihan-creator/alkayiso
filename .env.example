# Beispiel-Konfiguration für JARVIS. Kopieren nach .env (im Projektordner) oder %LOCALAPPDATA%\Jarvis\.env
# API-Schlüssel bitte NICHT hier, sondern in der Oberfläche (Setup → API-Schlüssel) speichern –
# sie landen dann im Windows-Anmeldeinformationsspeicher. Umgebungsvariablen funktionieren als Fallback.

# Backend lauscht nur lokal (empfohlen). Fernzugriff ausschließlich über Tailscale Serve.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Öffentliche Adresse für den Kopplungs-QR-Code (wird sonst automatisch aus Tailscale ermittelt)
# JARVIS_PUBLIC_URL=https://mein-pc.tailnet-1234.ts.net

# Freigegebene Ordner für Dateiaktionen (Trennzeichen ; unter Windows)
# JARVIS_ALLOWED_ROOTS=C:\Users\Name\Documents;C:\Users\Name\Desktop;C:\Users\Name\Downloads

# Datenordner (Standard: %LOCALAPPDATA%\Jarvis)
# JARVIS_DATA_DIR=

# Kopplung nur über Tailscale Serve zulassen (empfohlen: 1)
JARVIS_REQUIRE_TAILSCALE_PAIRING=1

# Fallback für Schlüssel (nur falls kein Schlüsselspeicher verfügbar ist)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
